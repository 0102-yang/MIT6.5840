{
    "name": "MIT6.5840",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "EditorConfig.EditorConfig",
                "eamodio.gitlens"
            ]
        },
        "settings": {
            "go.gopath": "/go",
            "go.goroot": "/usr/local/go",
            "go.toolsGopath": "/go/bin",
            "go.useLanguageServer": true
        }
    },
    "forwardPorts": [
        8080
    ],
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined"
    ],
    "remoteUser": "vscode"
}
