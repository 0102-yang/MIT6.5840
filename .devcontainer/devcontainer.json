{
    "name": "MIT6.5840",
    "image": "mcr.microsoft.com/devcontainers/go:dev-1.24-bookworm",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "GitHub.copilot"
            ]
        },
        "settings": {
            "go.gopath": "/go",
            "go.goroot": "/usr/local/go",
            "go.toolsGopath": "/go/bin",
            "go.useLanguageServer": true,
            "files.eol": "\n"
        }
    },
    "forwardPorts": [
        8080
    ],
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined",
        "--name",
        "mit6.5840-dev"
    ],
    "remoteUser": "vscode"
}